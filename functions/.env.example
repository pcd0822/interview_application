# Cloud Functions 파라미터 (functions/.env 로 복사해서 사용, git에 커밋 금지)
# GAS 웹앱 배포 URL (…/exec)
GAS_MAIL_URL=https://script.google.com/macros/s/XXXXXXXX/exec
# GAS_MAIL_TOKEN 은 Secret 입니다. 아래 명령으로 등록하세요(.env 에 넣지 않음):
#   firebase functions:secrets:set GAS_MAIL_TOKEN
# 로컬 에뮬레이터에서만 쓰려면 functions/.secret.local 에 GAS_MAIL_TOKEN=... 로 둘 수 있습니다.
